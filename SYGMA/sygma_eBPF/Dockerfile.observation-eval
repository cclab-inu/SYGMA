# Override only with another immutable digest. The checked-in default is kept
# locally available for the evaluation packaging flow.
ARG BASE_IMAGE=ubuntu@sha256:eb29ed27b0821dca09c2e28b39135e185fc1302036427d5f4d70a41ce8fd7659
FROM ${BASE_IMAGE}

WORKDIR /usr/daemon

# stage_observation_stack.sh builds this exact audited binary. Do not rebuild
# it in the image: the experiment verifies /usr/daemon/core byte-for-byte.
COPY core /usr/daemon/core
COPY route-snapshot /usr/daemon/route-snapshot

ENTRYPOINT ["/usr/daemon/core"]
