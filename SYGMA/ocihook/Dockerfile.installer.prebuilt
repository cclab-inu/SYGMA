FROM ubuntu@sha256:eb29ed27b0821dca09c2e28b39135e185fc1302036427d5f4d70a41ce8fd7659

# These are the same rebuilt host artifacts whose hashes are checked before
# packaging. The DaemonSet supplies /bin/sh and its installer script.
COPY build/sygma-hook /binaries/sygma-hook
COPY build/sygma-tracer /binaries/sygma-tracer
COPY build/sygma-wrapper /binaries/sygma-wrapper
COPY build/00-sygma /binaries/00-sygma

CMD ["/bin/ls", "-lh", "/binaries/"]
