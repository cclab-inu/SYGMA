ARG BASE_IMAGE=docker.io/jaegertracing/all-in-one@sha256:ab6f1a1f0fb49ea08bcd19f6b84f6081d0d44b364b6de148e1798eb5816bacac
FROM ${BASE_IMAGE}

COPY --chmod=0755 build/gap-probe /opt/gap/gap-launch

# Base ENTRYPOINT is fully self-sufficient (CMD is null); reproduce it
# verbatim after "--" so gap-launch's child argv is unchanged.
ENTRYPOINT ["/opt/gap/gap-launch", "--application", "hotel-jaeger", "--", "/go/bin/all-in-one-linux"]
