ARG BASE_IMAGE=us-central1-docker.pkg.dev/google-samples/microservices-demo/frontend@sha256:83f44050fc5ea5999ea04a940e687d7bd5ad357fcf6e6f5944e5e32de006bbdb
FROM ${BASE_IMAGE}

COPY --chmod=0755 build/gap-probe /opt/gap/gap-launch

# Base ENTRYPOINT is fully self-sufficient (CMD is null); reproduce it
# verbatim after "--" so gap-launch's child argv is unchanged.
ENTRYPOINT ["/opt/gap/gap-launch", "--application", "boutique-frontend", "--", "/src/server"]
