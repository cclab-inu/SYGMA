ARG BASE_IMAGE=us-central1-docker.pkg.dev/google-samples/microservices-demo/emailservice@sha256:59558f8e668e4edec7b40a928c2368696474a8da85ef912e278f8abb3200ecbe
FROM ${BASE_IMAGE}

COPY --chmod=0755 build/gap-probe /opt/gap/gap-launch

# Base ENTRYPOINT is fully self-sufficient (CMD is null); reproduce it
# verbatim after "--" so gap-launch's child argv is unchanged.
ENTRYPOINT ["/opt/gap/gap-launch", "--application", "boutique-email", "--", "python", "email_server.py"]
