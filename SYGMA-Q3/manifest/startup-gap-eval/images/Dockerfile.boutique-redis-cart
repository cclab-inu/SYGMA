ARG BASE_IMAGE=docker.io/library/redis@sha256:978f0e01593e65eed801f2402944efcd936d43b5027e4908a7897baf88ed6241
FROM ${BASE_IMAGE}

COPY --chmod=0755 build/gap-probe /opt/gap/gap-launch

# Re-declare the pinned base CMD because replacing ENTRYPOINT resets its CMD.
ENTRYPOINT ["/opt/gap/gap-launch", "--application", "boutique-redis-cart", "--", "docker-entrypoint.sh"]
CMD ["redis-server"]
