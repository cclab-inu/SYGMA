ARG BASE_IMAGE=us-central1-docker.pkg.dev/google-samples/microservices-demo/cartservice@sha256:598efe871d0251cbd35729972acb23c0723cb7aca451503ba10fb8116aecb958
FROM ${BASE_IMAGE}

COPY --chmod=0755 build/gap-probe /opt/gap/gap-launch

# Base ENTRYPOINT is fully self-sufficient (CMD is null); reproduce it
# verbatim after "--" so gap-launch's child argv is unchanged.
ENTRYPOINT ["/opt/gap/gap-launch", "--application", "boutique-cart", "--", "/app/cartservice"]
